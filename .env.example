# Copy this file to .env and fill in your local values. Never commit .env.
# PostgreSQL SQLAlchemy URL example (adjust database/user/password/host):
DATABASE_URL=postgresql+psycopg://friday_user:change_me@localhost:5432/friday_db

# Optional OpenAI-compatible chat-completions provider. Leave blank to use local summaries.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# Optional local Ollama classifier adapter (Phase 3; not enabled in production routing yet).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_MAX_BODY_CHARS=1200
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0
